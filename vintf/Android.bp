// gralloc mapper VINTF fragment (standalone, matches stock layout — NOT inlined into
// manifest.xml, since AOSP libui's openDeclaredPassthroughHal only resolves standalone
// fragments under etc/vintf/manifest/, per PLAYBOOK_FROM_OPUS_20260706_MAPPER_VINTF_FIX.md)
vintf_fragment {
    name: "mapper.qti.xml",
    src: "mapper.qti.xml",
    vendor: true,
}

// wifi HAL VINTF fragment for the stock blob android.hardware.wifi-service (2026-07-09)
vintf_fragment {
    name: "wifi-service.metroid.xml",
    src: "wifi-service.metroid.xml",
    vendor: true,
}

// audio: AGM/PAL/PALEventNotifier declarations (served by audiohalservice.qti blob).
// IListenSoundModel deliberately OMITTED — not served in this build (AGENTS.md warning #1).
vintf_fragment {
    name: "audio_qti_services.metroid.xml",
    src: "audio_qti_services.metroid.xml",
    vendor: true,
}


// audio effects IFactory declaration — audioserver hard-requires it (AudioFlinger::onFirstRef
// SIGSEGV without it). The QTI effects module's own fragment does NOT land in our image.
vintf_fragment {
    name: "audio_effects.metroid.xml",
    src: "audio_effects.metroid.xml",
    vendor: true,
}

// batch 1 of crash-looper declarations (2026-07-09): identity, power.stats, memtrack,
// sensorscalibrate, lights, snapdragonServices, fingerprint(+goodix daemon). Every one of
// these services RUNS and aborts on addService -3 (not declared) — so declaring is safe
// per the "only declare served HALs" rule. dspservice + wfdhdcp deferred (verify serve first).
vintf_fragment {
    name: "hal_batch1.metroid.xml",
    src: "hal_batch1.metroid.xml",
    vendor: true,
}

// batch 2 (2026-07-09 night): NFC (st HAL runs, aborts undeclared) + wfdhdcp drm instance
// (service runs, aborts undeclared). secure_element SIM1/SIM2 deferred until SIM present.
vintf_fragment {
    name: "hal_batch2.metroid.xml",
    src: "hal_batch2.metroid.xml",
    vendor: true,
}

// batch 3 (2026-07-09): Bluetooth HCI (+audio provider, SAR) + GNSS. QTI binaries exist
// (android.hardware.bluetooth@aidl-service-qti, android.hardware.gnss-aidl-service-qti);
// stack asked for these and got VINTF denials. finder/socket omitted (not in stock decls
// or unverified serve).
vintf_fragment {
    name: "hal_batch3.metroid.xml",
    src: "hal_batch3.metroid.xml",
    vendor: true,
}
