type ntcap, domain;
type ntcap_exec, exec_type, vendor_file_type, file_type;

# Mark the domain as permissive so SELinux denials don't block execution
permissive ntcap;

init_daemon_domain(ntcap)

# Necessary basic permissions for shell execution
allow ntcap vendor_shell_exec:file rx_file_perms;
allow ntcap vendor_toolbox_exec:file rx_file_perms;
allow ntcap kmsg_device:chr_file rw_file_perms;
allow ntcap mnt_vendor_file:dir create_dir_perms;
allow ntcap mnt_vendor_file:file create_file_perms;

# bootwatchdog.sh runs in this domain and must be able to trigger a reboot to the bootloader
# (setprop sys.powerctl). Bring-up only -- removed with the rest of the ntcap scaffolding.
set_prop(ntcap, powerctl_prop)
# bootwatchdog.sh: arm the BCB in /dev/block/by-name/misc and reboot via sysrq, bypassing init
# (init is blocked during the stalls this recovers from). Bring-up only.
allow ntcap misc_block_device:blk_file rw_file_perms;
allow ntcap proc_sysrq:file rw_file_perms;
