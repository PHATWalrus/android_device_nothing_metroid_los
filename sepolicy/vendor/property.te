# Camera
vendor_public_prop(vendor_camera_p3enable_prop)
vendor_public_prop(vendor_camera_sensor_prop)
vendor_public_prop(vendor_camera_xdrversion_prop)

# Fingerprint
vendor_public_prop(vendor_fp_prop)

# RIL
vendor_public_prop(vendor_deviceid_prop)
vendor_public_prop(vendor_sno_prop)

# Thermal
vendor_public_prop(vendor_thermal_normal_prop)

# metroid 2026-07-28: props hit while bringing SELinux to enforcing. These MUST have their own
# types — AOSP has a neverallow forbidding vendor domains from touching default_prop, so
# set_prop(hal_fingerprint_default, default_prop) fails the build rather than the boot.
vendor_internal_prop(vendor_fingerprint_prop)
