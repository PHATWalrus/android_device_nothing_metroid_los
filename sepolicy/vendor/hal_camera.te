
type vendor_hal_noth_camera_service,
    hal_service_type, protected_service, service_manager_type;

type vendor_hal_nothing_postproc_service,
    hal_service_type, protected_service, service_manager_type;

add_service(hal_camera_default, vendor_hal_noth_camera_service)
add_service(hal_camera_default, vendor_hal_nothing_postproc_service)

set_prop(hal_camera, vendor_camera_sensor_prop)
set_prop(hal_camera_default, vendor_camera_p3enable_prop)
set_prop(hal_camera_default, vendor_camera_xdrversion_prop)
get_prop(hal_camera_default, bpf_progs_loaded_prop)
get_prop(hal_camera_default, camera_config_prop)

r_dir_file(hal_camera_default, mnt_vendor_file)

hal_client_domain(hal_camera_default, hal_power)

# Nothing's camera extension queries the framework camera service for sensor
# metadata before it publishes its own vendor service.
allow hal_camera_default fwk_camera_service:service_manager find;
binder_call(hal_camera_default, cameraserver)

allow hal_camera_default self:capability { fowner ipc_lock };
