# BRING-UP ONLY -- remove before official submission.
# If a boot stalls in userspace the kernel stays alive, so ABL never counts a failed boot and never
# falls back to fastboot: recovering needs a physical Vol-Down+Power hold. This watchdog reboots into recovery (adb works there) if
# sys.boot_completed is not set within 7 minutes (a healthy boot here is ~200-310s),
# so a failed bring-up flash is always recoverable over USB with no hands on the device.
service vendor.bootwatchdog /vendor/bin/sh /vendor/bin/bootwatchdog.sh
    class core
    user root
    group root
    oneshot
    seclabel u:r:ntcap:s0

on init
    start vendor.bootwatchdog
