<resources>
    <!-- Enable UDC sysfs USB state update so UsbDeviceManager can monitor
         /sys/class/udc/<udc>/state and trigger USB notification popups on configfs-only HAL devices -->
    <bool name="config_enableUdcSysfsUsbStateUpdate">true</bool>
    <!-- Default to gestural navigation (no setup wizard runs to set it) -->
    <integer name="config_navBarInteractionMode">2</integer>
    <!-- Back gesture edge inset width — normally provided by the NavigationBarModeGesturalOverlay
         RRO (com.android.internal.systemui.navbar.gestural), but that overlay is NOT enabled by
         default. Baked here so back swipe works without the runtime enable command. -->
    <dimen name="config_backGestureInset">30dp</dimen>

