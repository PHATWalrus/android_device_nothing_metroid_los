    <!-- Create the (invisible) navigation bar. Without this, hasNavigationBar()=false ->
         SystemUI never builds the NavigationBar window that hosts EdgeBackGestureHandler
         (mIsAttached=false) -> the back swipe never registers even though touch is perfect.
         This was the actual root cause of "back gesture doesn't work" (NOT touch/firmware).
         Verified 2026-07-12 via qemu.hw.mainkeys=0 which forces the same hasNavigationBar=true. -->
    <bool name="config_showNavigationBar">true</bool>

