 }
diff --git a/libvmmem/vmmem.cpp b/libvmmem/vmmem.cpp
new file mode 100644
index 0000000..6d4acec
--- /dev/null
+++ b/libvmmem/vmmem.cpp
@@ -0,0 +1,15 @@
+#include "vmmem.h"
+#include <memory>
+
+class VmMemDummy : public VmMem {
+public:
+    ~VmMemDummy() override {}
+    int FindVmByName(const std::string& /*vm_name*/) override { return 0; }
+    int LendDmabuf(int /*fd*/, const VmPerm& /*vm_perms*/) override { return 0; }
+};
+
+VmMem::~VmMem() {}
+
+std::unique_ptr<VmMem> VmMem::CreateVmMem() {
+    return std::make_unique<VmMemDummy>();
+}
