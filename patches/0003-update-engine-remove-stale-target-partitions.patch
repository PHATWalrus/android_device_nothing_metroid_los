+TEST_P(DynamicPartitionControlAndroidGroupTestP,
+       RemovesStaleTargetPartitionBeforeRecreatingGroups) {
+  auto super_metadata = NewFakeMetadata(source_manifest);
+  ASSERT_NE(nullptr,
+            super_metadata->AddPartition(T("system_ext"), "default", 0));
+
+  DeltaArchiveManifest update_manifest;
+  auto* group = AddGroup(&update_manifest, "android", 3_GiB);
+  AddPartition(&update_manifest, group, "system", 2_GiB);
+  AddPartition(&update_manifest, group, "system_ext", 1_GiB);
+
+  ASSERT_TRUE(module_->UpdatePartitionMetadata(
+      super_metadata.get(), target(), update_manifest));
+
+  DeltaArchiveManifest expected;
+  group = AddGroup(&expected, T("android"), 3_GiB);
+  AddPartition(&expected, group, T("system"), 2_GiB);
+  AddPartition(&expected, group, T("system_ext"), 1_GiB);
+  ASSERT_THAT(super_metadata.get(), MetadataMatches(expected));
+}
