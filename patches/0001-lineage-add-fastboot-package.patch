diff --git a/build/tasks/bacon.mk b/build/tasks/bacon.mk
index 272a4b8..9775150 100644
--- a/build/tasks/bacon.mk
+++ b/build/tasks/bacon.mk
@@ -13,17 +13,35 @@
 # See the License for the specific language governing permissions and
 # limitations under the License.
 
+SHA256 := prebuilts/build-tools/path/$(HOST_PREBUILT_TAG)/sha256sum
+
 # -----------------------------------------------------------------
 # Lineage OTA update package
 
+ifneq ($(PRODUCT_BUILD_OTA_PACKAGE),false)
 LINEAGE_TARGET_PACKAGE := $(PRODUCT_OUT)/lineage-$(LINEAGE_VERSION).zip
 
-SHA256 := prebuilts/build-tools/path/$(HOST_PREBUILT_TAG)/sha256sum
-
 $(LINEAGE_TARGET_PACKAGE): $(INTERNAL_OTA_PACKAGE_TARGET)
 	$(hide) ln -f $(INTERNAL_OTA_PACKAGE_TARGET) $(LINEAGE_TARGET_PACKAGE)
 	$(hide) $(SHA256) $(LINEAGE_TARGET_PACKAGE) | sed "s|$(PRODUCT_OUT)/||" > $(LINEAGE_TARGET_PACKAGE).sha256sum
 	@echo "Package Complete: $(LINEAGE_TARGET_PACKAGE)" >&2
+endif
+
+ifeq ($(PRODUCT_BUILD_FASTBOOT_PACKAGE),true)
+LINEAGE_FASTBOOT_PACKAGE := $(PRODUCT_OUT)/lineage-$(LINEAGE_VERSION)-fastboot.zip
+
+$(LINEAGE_FASTBOOT_PACKAGE): $(BUILT_TARGET_FILES_PACKAGE) $(IMG_FROM_TARGET_FILES)
+	$(hide) $(IMG_FROM_TARGET_FILES) $(BUILT_TARGET_FILES_PACKAGE) $@
+	$(hide) $(SHA256) $(LINEAGE_FASTBOOT_PACKAGE) | sed "s|$(PRODUCT_OUT)/||" > $(LINEAGE_FASTBOOT_PACKAGE).sha256sum
+	@echo "Fastboot package complete: $(LINEAGE_FASTBOOT_PACKAGE)" >&2
+
+endif
 
 .PHONY: bacon
+ifeq ($(PRODUCT_BUILD_FASTBOOT_PACKAGE),true)
+bacon: $(LINEAGE_FASTBOOT_PACKAGE) $(DEFAULT_GOAL)
+else ifneq ($(PRODUCT_BUILD_OTA_PACKAGE),false)
 bacon: $(LINEAGE_TARGET_PACKAGE) $(DEFAULT_GOAL)
+else
+bacon: $(DEFAULT_GOAL)
+endif
