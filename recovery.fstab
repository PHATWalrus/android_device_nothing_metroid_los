# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

#<src>                                    <mnt_point>            <type>   <mnt_flags and options>                                       <fs_mgr_flags>
system                                    /system                erofs    ro                                                             wait,slotselect,avb=vbmeta_system,logical,first_stage_mount
system                                    /system                ext4     ro                                                             wait,slotselect,avb=vbmeta_system,logical,first_stage_mount
system_ext                                /system_ext            erofs    ro                                                             wait,slotselect,avb=vbmeta_system,logical,first_stage_mount
system_ext                                /system_ext            ext4     ro                                                             wait,slotselect,avb=vbmeta_system,logical,first_stage_mount
product                                   /product               erofs    ro                                                             wait,slotselect,avb=vbmeta_system,logical,first_stage_mount
product                                   /product               ext4     ro                                                             wait,slotselect,avb=vbmeta_system,logical,first_stage_mount
vendor                                    /vendor                erofs    ro                                                             wait,slotselect,avb=vbmeta_vendor,logical,first_stage_mount
vendor                                    /vendor                ext4     ro                                                             wait,slotselect,avb=vbmeta_vendor,logical,first_stage_mount
vendor_dlkm                               /vendor_dlkm           erofs    ro                                                             wait,slotselect,avb=vbmeta_vendor,logical,first_stage_mount
vendor_dlkm                               /vendor_dlkm           ext4     ro                                                             wait,slotselect,avb=vbmeta_vendor,logical,first_stage_mount
system_dlkm                               /system_dlkm           erofs    ro                                                             wait,slotselect,avb=vbmeta_vendor,logical,first_stage_mount
system_dlkm                               /system_dlkm           ext4     ro                                                             wait,slotselect,avb=vbmeta_vendor,logical,first_stage_mount
odm                                       /odm                   erofs    ro                                                             wait,slotselect,avb=vbmeta_vendor,logical,first_stage_mount
odm                                       /odm                   ext4     ro                                                             wait,slotselect,avb=vbmeta_vendor,logical,first_stage_mount

/dev/block/by-name/boot                   /boot                  emmc     defaults                                                       slotselect,avb=vbmeta,first_stage_mount,recoveryonly
/dev/block/by-name/init_boot              /init_boot             emmc     defaults                                                       slotselect,avb=vbmeta,first_stage_mount,recoveryonly
/dev/block/by-name/vendor_boot            /vendor_boot           emmc     defaults                                                       slotselect,avb=vbmeta,first_stage_mount,recoveryonly
/dev/block/by-name/dtbo                   /dtbo                  emmc     defaults                                                       slotselect,avb=vbmeta,first_stage_mount,recoveryonly
/dev/block/by-name/recovery               /recovery              emmc     defaults                                                       slotselect,avb=vbmeta,first_stage_mount,recoveryonly
/dev/block/by-name/metadata               /metadata              f2fs     noatime,nosuid,nodev,discard                                   wait,check,formattable,first_stage_mount
/dev/block/bootdevice/by-name/userdata    /data                  f2fs     noatime,nosuid,nodev,discard,reserve_root=131072,resgid=1065,fsync_mode=nobarrier latemount,wait,check,formattable,quota,reservedsize=128M
/dev/block/by-name/misc                   /misc                  emmc     defaults                                                       recoveryonly

/dev/block/bootdevice/by-name/persist     /mnt/vendor/persist    ext4     noatime,nosuid,nodev,barrier=1                                 wait
/dev/block/bootdevice/by-name/modem       /vendor/firmware_mnt   vfat     ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0 wait,slotselect
/dev/block/bootdevice/by-name/dsp         /vendor/dsp            ext4     ro,nosuid,nodev,barrier=1                                      wait,slotselect
/dev/block/bootdevice/by-name/nt_log      /mnt/product/nt_log    ext4     noatime,nosuid,nodev,discard,barrier=1                         wait,check,formattable,first_stage_mount,nofail
/dev/block/bootdevice/by-name/nt_log      /mnt/vendor/nt_log     ext4     noatime,nosuid,nodev,discard,barrier=1                         wait,check,formattable,first_stage_mount,nofail
