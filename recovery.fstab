# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

#<src>                                    <mnt_point>    <type>    <mnt_flags and options>    <fs_mgr_flags>
system                                    /system        erofs     ro                         wait,logical,first_stage_mount
system_ext                                /system_ext    erofs     ro                         wait,logical,first_stage_mount
vendor                                    /vendor        erofs     ro                         wait,logical,first_stage_mount
product                                   /product       erofs     ro                         wait,logical,first_stage_mount
odm                                       /odm           erofs     ro                         wait,logical,first_stage_mount

/dev/block/by-name/metadata               /metadata      ext4      noatime,nosuid,nodev,discard wait,check,formattable,first_stage_mount
/dev/block/bootdevice/by-name/userdata    /data          f2fs      noatime,nosuid,nodev,discard,inline_xattr,inline_data,reserve_root=32768,resgid=1065,fsync_mode=nobarrier wait,check,formattable,latemount,resize,reservedsize=128m,checkpoint=fs,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,fsverity

/dev/block/bootdevice/by-name/boot        /boot          emmc      defaults                   recoveryonly
/dev/block/bootdevice/by-name/recovery    /recovery      emmc      defaults                   recoveryonly
/dev/block/bootdevice/by-name/misc        /misc          emmc      defaults                   recoveryonly
